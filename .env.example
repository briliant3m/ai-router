# ─── Bitrix24 ────────────────────────────────────────────────────────────────
# Исходящий webhook (для API-вызовов от агента к Bitrix)
# Настройки → Разработчикам → Входящий webhook → скопировать URL
BITRIX_WEBHOOK_URL=https://YOUR-DOMAIN.bitrix24.ru/rest/1/YOUR-TOKEN/

# Секрет, который добавляется в URL вашего сервера: ?token=...
# Придумай сам: любая строка без пробелов, например: x7kQ3mR9pL
BITRIX_INCOMING_TOKEN=your_secret_token_here

# ID стадии «Лиды Общая» в Bitrix (формат C12:UC_XXXXX)
TARGET_STAGE_ID=C12:UC_GWJMC3

# ─── Поля сделки ─────────────────────────────────────────────────────────────
FIELD_CATEGORY=UF_CRM_1779777388913
FIELD_MACHINE_TYPE=UF_CRM_1779795995888
FIELD_BUDGET=UF_CRM_1779795853359
FIELD_TIMELINE=UF_CRM_1764670311442
FIELD_REGION=UF_CRM_1781090253342
FIELD_SUBCATEGORY=UF_CRM_1779795936957

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE

# ─── Google Sheets ───────────────────────────────────────────────────────────
# ID таблицы — из URL: https://docs.google.com/spreadsheets/d/{ID}/edit
GOOGLE_SHEETS_ID=YOUR-SPREADSHEET-ID-HERE

# JSON service account — одной строкой (без переносов)
# Как получить: Google Cloud Console → IAM → Service Accounts → Keys → JSON
# Затем поделиться таблицей с email сервисного аккаунта (editor)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
